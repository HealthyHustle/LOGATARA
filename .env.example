# Server Configuration
PORT=3001
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# Authentication Secret (replace with a strong random string in production)
JWT_SECRET=logatara-dev-secret-change-in-production-nusantara-2026

# Database Configuration
# Leave DATABASE_URL empty to automatically use local persistent SQLite (backend/database/logatara.sqlite).
# Set DATABASE_URL to connect directly to PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# AI Provider Configuration (LOGATARA AI Chatbot & Assisted Translation)
# Primary Option: n8n AI Agent Webhook & Live User Event Logger
N8N_AI_WEBHOOK_URL=https://dpwppijabar.app.n8n.cloud/webhook/logatara-ai
VITE_N8N_AI_WEBHOOK_URL=https://dpwppijabar.app.n8n.cloud/webhook/logatara-ai
N8N_USER_EVENTS_WEBHOOK_URL=https://dpwppijabar.app.n8n.cloud/webhook/logatara-user-events
VITE_N8N_USER_EVENTS_WEBHOOK_URL=https://dpwppijabar.app.n8n.cloud/webhook/logatara-user-events

# Option 2: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option 3: OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
